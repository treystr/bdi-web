---
import { getCollection, render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import CategoryPill from '@components/ui/CategoryPill.astro';
import Date from '@components/ui/Date.astro';
import BarChart from '@components/charts/BarChart.astro';
import PieChart from '@components/charts/PieChart.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '@data/config';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    const publishedPosts = posts.filter((post) => import.meta.env.DEV || post.data.publish !== false);
    return publishedPosts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const shouldRenderSurveyCharts = post.id === 'smb-survey';

interface SurveyChartItem {
    question: string;
    data: { label: string; count: number }[];
}

let surveyData: SurveyChartItem[] | null = null;
let surveyError = false;

if (shouldRenderSurveyCharts) {
    try {
        const response = await fetch('https://raw.githubusercontent.com/treystr/bdi-data/main/survey/results.json');
        if (!response.ok) {
            throw new Error(`Survey request failed with ${response.status}`);
        }

        const payload = await response.json();
        surveyData = Array.isArray(payload?.data) ? payload.data : null;
    } catch (error) {
        console.error('Unable to fetch survey chart data for blog post:', error);
        surveyError = true;
    }
}

// Use SEO data from frontmatter if available, fallback to regular post data
const seoTitle = post.data.seo?.title || post.data.title;
const seoDescription = post.data.seo?.description || post.data.excerpt;

// For SEO image, use the seo.image if provided, otherwise use the featured image
let seoImage: string | undefined = post.data.seo?.image;

// If seoImage is provided but not an absolute URL, make it absolute
if (seoImage && !seoImage.startsWith('http')) {
    seoImage = seoImage.startsWith('/') ? seoImage : `/${seoImage}`;
}
// If no SEO image is specified, but we have a featured image, use its src property
else if (!seoImage && post.data.featuredImage) {
    // featuredImage is an ImageMetadata object from Astro's content collections
    // We can use its src property directly, which Astro will process during build
    seoImage = post.data.featuredImage.src;
}

const canonicalPath = `/blog/${post.id}`;
const canonicalUrl = new URL(canonicalPath, siteConfig.siteUrl).toString();
const articleSection = post.data.categories?.[0];
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    mainEntityOfPage: canonicalUrl,
    headline: seoTitle,
    description: seoDescription,
    datePublished: post.data.publishDate.toISOString(),
    image: seoImage ? [new URL(seoImage, siteConfig.siteUrl).toString()] : undefined,
    author: {
        '@type': 'Organization',
        name: siteConfig.companyName
    },
    publisher: {
        '@type': 'Organization',
        name: siteConfig.companyName,
        url: siteConfig.siteUrl
    }
};
---

<Layout
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
    canonicalUrl={canonicalPath}
    ogType="article"
    publishedTime={post.data.publishDate.toISOString()}
    section={articleSection}
    imageAlt={post.data.title}
    jsonLd={jsonLd}
>
    <PageHeader 
        title={post.data.title} 
        description={post.data.excerpt} 
        background="base" 
    />

    <article class="site-container--article mx-auto px-4 pb-base">
        <div class="flex items-center justify-center gap-4 text-body-base/70 mb-8">
            <Date date={post.data.publishDate} />
            {
                post.data.categories && (
                    <div class="flex flex-wrap gap-2">
                        {post.data.categories.map((category) => (
                            <CategoryPill category={category} />
                        ))}
                    </div>
                )
            }
        </div>

        {
            post.data.featuredImage && (
                <Image
                    src={post.data.featuredImage}
                    alt={post.data.title}
                    width={1200}
                    height={675}
                    class="w-full h-auto rounded-lg border mb-12 border-black"
                    quality={80}
                    format="webp"
                />
            )
        }

        <div class="prose prose-lg max-w-none">
            <Content />
        </div>

        {shouldRenderSurveyCharts && surveyData && (
            <section class="mt-16 not-prose">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-bold mb-3">Survey Result Charts</h2>
                    <p class="text-body-muted">
                        Live visualized results from our local business survey data.
                    </p>
                </div>

                <div class="grid lg:grid-cols-2 gap-8">
                    {surveyData[0] && (
                        <BarChart
                            id="blog-payment-issues-chart"
                            title={surveyData[0].question}
                            data={surveyData[0].data}
                        />
                    )}
                    {surveyData[1] && (
                        <BarChart
                            id="blog-business-investment-chart"
                            title={surveyData[1].question}
                            data={surveyData[1].data}
                        />
                    )}
                    {surveyData[2] && (
                        <PieChart
                            id="blog-bitcoin-familiarity-chart"
                            title={surveyData[2].question}
                            data={surveyData[2].data}
                        />
                    )}
                    {surveyData[3] && (
                        <PieChart
                            id="blog-acceptance-readiness-chart"
                            title={surveyData[3].question}
                            data={surveyData[3].data}
                        />
                    )}
                    {surveyData[4] && (
                        <BarChart
                            id="blog-adoption-drivers-chart"
                            title={surveyData[4].question}
                            data={surveyData[4].data}
                        />
                    )}
                    {surveyData[5] && (
                        <PieChart
                            id="blog-follow-up-chart"
                            title={surveyData[5].question}
                            data={surveyData[5].data}
                        />
                    )}
                </div>
            </section>
        )}

        {shouldRenderSurveyCharts && surveyError && (
            <section class="mt-16 not-prose">
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 text-center">
                    <h2 class="text-lg font-semibold text-yellow-800 mb-2">Survey charts are temporarily unavailable</h2>
                    <p class="text-sm text-yellow-700">
                        The narrative summary is still available above while we reconnect the chart data feed.
                    </p>
                </div>
            </section>
        )}
    </article>
</Layout>
