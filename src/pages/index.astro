---
export const prerender = false;

import Layout from '@layouts/Layout.astro';
import PressHeroCarousel from '@components/sections/PressHeroCarousel.astro';
import AnnouncementsSpotlight from '@components/sections/AnnouncementsSpotlight.astro';
import CtaBanner from '@components/sections/CtaBanner.astro';
import MerchantMap from '@components/sections/MerchantMap.astro';
import MerchantMasonryGallery from '@components/sections/MerchantMasonryGallery.astro';
import BlogPostCarousel from '@components/sections/BlogPostCarousel.astro';
import heroImage from '../assets/images/hero/hero-market.jpg';

const seoTitle = "Home";
const seoDescription = "Our Initiative is building a grassroots Bitcoin circular economy in Washington, DC through education, business adoption, and community outreach.";
const canonicalPath = "/";

const pressHeroContent = {
    title: "Bitcoin Is Working — Right Here in DC",
    description: "Join a growing network of DC residents and businesses using Bitcoin every day.",
    button: {
        text: "Get Started",
        link: "/contact",
        variant: "primary" as const,
        size: "xl" as const,
    },
}

const announcementsSection = {
    eyebrow: "What's New",
    title: "Announcements",
    description: "Catch the latest partnerships, events, and community updates from Bitcoin District Initiative.",
};

const merchantGallerySection = {
    eyebrow: "Bitcoin Circular Economy",
    title: "Recent Merchants Proudly Accepting Bitcoin",
    description: "These businesses recently joined our local Bitcoin economy. Support them and help strengthen peer-to-peer commerce in DC.",
};

const joinDistrictSection = {
    eyebrow: "MEET THE COMMUNITY",
    title: "Join Bitcoin District",
    description: "Bitcoin District started as a group of friends and small business owners learning together. Today, it's a citywide community of merchants, educators, and neighbors helping each other use Bitcoin in everyday life. Come to a meetup, learn from peers, and share your experience",
    button: {
        text: "Visit BitcoinDistrict.org",
        link: "https://bitcoindistrict.org",
        target: "_blank" as const,
        variant: "primary" as const
    }
}

const blogCarouselContent = {
    eyebrow: "Latest Updates",
    title: "Ready to Learn More?",
    description: "Bitcoin can be confusing — we're here to make it simple. Explore our latest guides and community stories to learn at your own pace.",
    button: {
        text: "View All Posts",
        link: "/blog",
        variant: "primary" as const
    }
};

---

<Layout
    title={seoTitle}
    description={seoDescription}
    canonicalUrl={canonicalPath}
    image={heroImage.src}
    imageAlt="Bitcoin community events and local business adoption in Washington, DC"
>
    <PressHeroCarousel 
        content={pressHeroContent}
        fallbackImage={heroImage}
        limit={6}
        autoAdvanceMs={6000}
        filterByType="events"
    />
    <AnnouncementsSpotlight
        eyebrow={announcementsSection.eyebrow}
        title={announcementsSection.title}
        description={announcementsSection.description}
        background="light"
        padding="small"
        limit={6}
    />
    <MerchantMasonryGallery
        eyebrow={merchantGallerySection.eyebrow}
        title={merchantGallerySection.title}
        description={merchantGallerySection.description}
        background="base"
        padding="small"
        limit={8}
        showAllLink="/merchants"
        showAllLabel="See all Merchants"
    />
    <MerchantMap 
        title="Put Your Business on the BTC Map"
        description="Put your business on the map — literally. Joining DC's Bitcoin merchants means joining a network that values local commerce and economic freedom. The BTC Map helps customers find and support you right away."
        topBackground="dark" 
        bottomBackground="base"
    />
    <BlogPostCarousel 
        content={blogCarouselContent}
        background="base"
        padding="small"
        showFeatured={false}
        fallbackToAll={true}
        minPosts={3}
        showLatest={true}
        limit={8}
    />
    <CtaBanner 
        content={joinDistrictSection} 
        background="dark" 
        padding="small" 
        variant="full-width" 
    />
</Layout>
