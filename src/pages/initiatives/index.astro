---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import InitiativeCards from '@components/sections/InitiativeCards.astro';
import CtaBanner from '@components/sections/CtaBanner.astro';
import heroImage from '@assets/images/hero/hero-bizgrid.jpg';
import { donateCta } from '@data/donateCta';
import { siteConfig } from '@data/config';

const seoTitle = "Our Initiatives";
const seoDescription = "Discover how the Bitcoin District Initiative builds a Bitcoin circular economy in DC through education, business adoption, and community outreach.";

const completedInitiativesSection = {
    headline: "Completed Initiatives",
    description: "Take a look at initiatives we've successfully completed.",
};
const canonicalPath = "/initiatives";
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: seoTitle,
    description: seoDescription,
    url: new URL(canonicalPath, siteConfig.siteUrl).toString(),
    isPartOf: {
        "@type": "WebSite",
        name: siteConfig.companyName,
        url: siteConfig.siteUrl
    }
};
---

<Layout
    title={seoTitle}
    description={seoDescription}
    image={heroImage.src}
    imageAlt="Businesses and community highlights from BDI initiatives"
    canonicalUrl={canonicalPath}
    jsonLd={jsonLd}
>
    <PageHeader 
        title="Our Initiatives" 
        description="These are the active projects driving our mission to build a Bitcoin circular economy in the Nation's Capital by bringing Bitcoin to Main Street DC." 
        background="base" 
    />

    <!-- Active Initiatives -->
    <InitiativeCards
        statusFilter="active"
        background="light"
        padding="base"
    />

    <!-- Completed Initiatives
    <InitiativeCards
        content={completedInitiativesSection}
        statusFilter="completed"
        background="base"
        padding="base"
    /> -->

    <!-- Donate CTA -->
    <CtaBanner
        content={donateCta}
        variant="contained"
        background="dark"
        padding="large"
    />
</Layout>
