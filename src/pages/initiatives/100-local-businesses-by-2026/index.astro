---
export const prerender = false;

import { getEntry, render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { siteConfig } from '@data/config';
import PageHeader from '@components/sections/PageHeader.astro';
import CtaBanner from '@components/sections/CtaBanner.astro';
import FeatureList from '@components/sections/FeatureList.astro';
import InitiativeCardsGrid from '@components/initiatives/InitiativeCardsGrid.astro';
import { getMerchants, type Merchant } from '@lib/directus';

// Fetch merchants from CMS
const merchantResult = await getMerchants();
const merchants: Merchant[] = merchantResult.data ?? [];
const cmsError = merchantResult.error;
const latestMerchants = [...merchants]
    .sort((a, b) => {
        const blockA = a.Onboard_Block ?? -1;
        const blockB = b.Onboard_Block ?? -1;
        if (blockA !== blockB) return blockB - blockA;

        const dateA = a.Onboard_Date ? new Date(a.Onboard_Date).getTime() : 0;
        const dateB = b.Onboard_Date ? new Date(b.Onboard_Date).getTime() : 0;
        if (dateA !== dateB) return dateB - dateA;

        return b.id - a.id;
    })
    .slice(0, 5);

// Get the initiative entry
const entry = await getEntry('initiatives', '100-local-businesses-by-2026');
if (!entry) {
    return Astro.redirect('/404');
}

const { Content } = await render(entry);

// Use SEO data from frontmatter if available
const seoTitle = entry.data.seo?.title || entry.data.title;
const seoDescription = entry.data.seo?.description || entry.data.shortDescription;
let seoImage: string | undefined = entry.data.seo?.image;
if (seoImage && !seoImage.startsWith('http')) {
    seoImage = seoImage.startsWith('/') ? seoImage : `/${seoImage}`;
} else if (!seoImage) {
    seoImage = entry.data.hero?.image?.src ?? entry.data.cardImage.src;
}
const canonicalPath = '/initiatives/100-local-businesses-by-2026';
const canonicalUrl = new URL(canonicalPath, siteConfig.siteUrl).toString();
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: seoTitle,
    description: seoDescription,
    url: canonicalUrl,
    image: seoImage ? [new URL(seoImage, siteConfig.siteUrl).toString()] : undefined,
    isPartOf: {
        '@type': 'WebSite',
        name: siteConfig.companyName,
        url: siteConfig.siteUrl
    }
};

// Page header content
const pageHeaderContent = {
    title: entry.data.title,
    description: entry.data.shortDescription,
    progress: {
        current: merchants.length,
        goal: 100,
        label: "Merchants Onboarded"
    }
};

// How We Support Merchants content
const merchantSupportContent = {
    title: "Supporting Merchants Every Step of the Way",
    description: "Whether a business is brand new to Bitcoin or already accepting it, we're here to help them succeed. Our approach combines hands-on onboarding with ongoing community support.",
    features: [
        {
            emoji: "🤝",
            title: "Direct Merchant Onboarding",
            description: "We work one-on-one with local businesses to help them start accepting Bitcoin. From choosing the right payment processor like Square to setting up a self-custody wallet, we guide merchants through every step of the process."
        },
        {
            emoji: "🗺️",
            title: "Welcoming Map-Listed Merchants",
            description: "For businesses that have already enabled Bitcoin payments and appear on the BTC Map, we visit in person to introduce them to the local Bitcoin community, answer questions, and ensure they feel supported."
        },
        {
            emoji: "🪧",
            title: "Professional Signage",
            description: "We provide merchants with high-quality \"Bitcoin Accepted Here\" signage to display in their windows and at checkout, helping attract Bitcoin-spending customers and signaling their participation in the circular economy."
        },
        {
            emoji: "📚",
            title: "Educational Resources",
            description: "Every merchant receives educational materials covering Bitcoin basics, transaction tips, and best practices—empowering them to confidently serve Bitcoin customers and manage their payments."
        }
    ]
};

// Donate CTA
const donateCta = {
    eyebrow: "SUPPORT THIS INITIATIVE",
    title: `Help Us Achieve: ${entry.data.title}`,
    description: "Your donation directly funds this program and helps us create lasting impact in DC communities. Every contribution, big or small, makes a difference.",
    buttons: [
        {
            text: "Donate Now",
            link: "/donate",
            variant: "primary" as const
        },
        {
            text: "Contact Us",
            link: "/contact",
            variant: "secondary" as const
        }
    ]
};
---

<Layout
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
    imageAlt={entry.data.title}
    canonicalUrl={canonicalPath}
    jsonLd={jsonLd}
>
    <PageHeader 
        title={pageHeaderContent.title} 
        description={pageHeaderContent.description} 
        background="base"
        progress={pageHeaderContent.progress}
    />

    {/* Main Content */}
    <article class="site-container--article mx-auto px-4 prose prose-lg mt-8 mb-16">
        <Content />
    </article>

    {/* How We Support Merchants */}
    <FeatureList 
        content={merchantSupportContent}
        background="light"
        paddingTop="base"
        paddingBottom="large"
        columns={2}
    />

    {/* Initiative Cards Grid */}
    <InitiativeCardsGrid
        background="base"
        merchants={latestMerchants}
        error={cmsError}
        cardLinkMode="merchant"
        showJourneyContinuation={false}
    />

    <section class="site-container--content mx-auto px-4 pb-10 -mt-4">
        <div class="text-center">
            <a
                href="/merchants"
                class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-dark transition-colors"
            >
                View all merchants
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>
    </section>

    {/* Donate CTA */}
    <CtaBanner
        content={donateCta}
        variant="contained"
        background="dark"
        padding="large"
    />

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const copyBtn = document.getElementById('copy-link-btn');
            if (copyBtn) {
                copyBtn.addEventListener('click', async () => {
                    const link = copyBtn.getAttribute('data-link');
                    if (link) {
                        try {
                            await navigator.clipboard.writeText(link);
                            const originalText = copyBtn.textContent;
                            copyBtn.textContent = 'Copied!';
                            setTimeout(() => {
                                copyBtn.textContent = originalText;
                            }, 2000);
                        } catch (err) {
                            console.error('Failed to copy:', err);
                        }
                    }
                });
            }
        });
    </script>
</Layout>

