---
export const prerender = false;

import { getEntry, render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { siteConfig } from '@data/config';
import PageHeader from '@components/sections/PageHeader.astro';
import CtaBanner from '@components/sections/CtaBanner.astro';
import CommunityPartnershipsGrid from '@components/initiatives/CommunityPartnershipsGrid.astro';

const entry = await getEntry('initiatives', 'community-partnerships');
if (!entry) {
    return Astro.redirect('/404');
}

const { Content } = await render(entry);

const seoTitle = entry.data.seo?.title || entry.data.title;
const seoDescription = entry.data.seo?.description || entry.data.shortDescription;
let seoImage: string | undefined = entry.data.seo?.image;
if (seoImage && !seoImage.startsWith('http')) {
    seoImage = seoImage.startsWith('/') ? seoImage : `/${seoImage}`;
} else if (!seoImage) {
    seoImage = entry.data.hero?.image?.src ?? entry.data.cardImage.src;
}

const canonicalPath = '/initiatives/community-partnerships';
const canonicalUrl = new URL(canonicalPath, siteConfig.siteUrl).toString();
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: seoTitle,
    description: seoDescription,
    url: canonicalUrl,
    image: seoImage ? [new URL(seoImage, siteConfig.siteUrl).toString()] : undefined,
    isPartOf: {
        '@type': 'WebSite',
        name: siteConfig.companyName,
        url: siteConfig.siteUrl,
    },
};

const pageHeaderContent = {
    title: entry.data.title,
    description: entry.data.shortDescription,
};

const donateCta = {
    eyebrow: 'SUPPORT THIS INITIATIVE',
    title: `Help Us Grow: ${entry.data.title}`,
    description:
        'Your donation helps us equip community organizations with Bitcoin education and strategic support so they can build long-term resilience.',
    buttons: [
        {
            text: 'Donate Now',
            link: '/donate',
            variant: 'primary' as const,
        },
        {
            text: 'Contact Us',
            link: '/contact',
            variant: 'secondary' as const,
        },
    ],
};
---

<Layout
    title={seoTitle}
    description={seoDescription}
    image={seoImage}
    imageAlt={entry.data.title}
    canonicalUrl={canonicalPath}
    jsonLd={jsonLd}
>
    <PageHeader title={pageHeaderContent.title} description={pageHeaderContent.description} background="base" />

    <article class="site-container--article mx-auto px-4 prose prose-lg mt-8 mb-16 hidden md:block">
        <Content />
    </article>

    <section class="site-container--content mx-auto px-4 mt-4 mb-6 md:hidden">
        <p class="text-sm text-body-base/75 m-0">
            Explore our active community partnerships below.
        </p>
    </section>

    <CommunityPartnershipsGrid background="light" />

    <CtaBanner content={donateCta} variant="contained" background="dark" padding="large" />
</Layout>
