---
import Button from '@components/ui/Button.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import { getAnnouncements, getAnnouncementImageUrl, type Announcement } from '@lib/directus';
import { getPaddingClass, getBackgroundColor, getTextColor } from '@utils/styleUtils';
import type { PaddingSize, ThemeColor } from '@utils/styleUtils';

export interface Props {
    title?: string;
    description?: string;
    eyebrow?: string;
    background?: ThemeColor;
    padding?: PaddingSize;
    paddingTop?: PaddingSize;
    paddingBottom?: PaddingSize;
    limit?: number;
    announcements?: Announcement[];
}

const {
    title = 'Community Announcements',
    description = 'Stay up to date with the latest partnerships, events, and updates from Bitcoin District Initiative.',
    eyebrow = 'Latest News',
    background = 'light',
    padding,
    paddingTop,
    paddingBottom,
    limit = 6,
    announcements: propAnnouncements,
} = Astro.props;

let items: Announcement[] = [];
if (propAnnouncements) {
    items = propAnnouncements;
} else {
    const result = await getAnnouncements();
    items = result.data ?? [];
}

const limitedItems = items.slice(0, limit);
const shouldRender = limitedItems.length > 0;

const featuredItem = limitedItems.find((item) => item.is_featured) ?? limitedItems[0];
const orderedItems = shouldRender
    ? [
        featuredItem,
        ...limitedItems.filter((item) => item.id !== featuredItem.id),
    ]
    : [];

const sectionId = `announcements-${Math.random().toString(36).slice(2, 10)}`;
const bgColor = getBackgroundColor(background);
const textColor = getTextColor(background);
const paddingClass = getPaddingClass({ padding, paddingTop, paddingBottom });

function getPrimaryTypeLabel(value: Announcement['type']): string | null {
    if (Array.isArray(value)) {
        const first = value.find((entry) => typeof entry === 'string' && entry.trim().length > 0);
        return first ? first : null;
    }
    if (typeof value === 'string' && value.trim().length > 0) return value;
    return null;
}
---

{shouldRender && (
    <section class:list={['announcement-spotlight', bgColor, paddingClass]} data-announcement-spotlight id={sectionId}>
        <div class="site-container--content px-4">
            <div class="announcement-spotlight__header">
                {eyebrow && <Eyebrow text={eyebrow} background={background} />}
                <h2 class:list={['announcement-spotlight__title', textColor]}>{title}</h2>
                <p class:list={['announcement-spotlight__description', textColor]}>{description}</p>
            </div>

            <div class="announcement-spotlight__layout">
                <div class="announcement-spotlight__featured">
                    {orderedItems.map((item, index) => {
                        const imageUrl = getAnnouncementImageUrl(item.image, 1200);
                        const typeLabel = getPrimaryTypeLabel(item.type);
                        const linkLabel = item.link_label?.trim() || 'Learn More';

                        return (
                            <article
                                class:list={['announcement-panel', { 'is-active': index === 0 }]}
                                data-announcement-panel={index}
                                id={`${sectionId}-panel-${index}`}
                                role="tabpanel"
                                aria-labelledby={`${sectionId}-tab-${index}`}
                                aria-hidden={index === 0 ? 'false' : 'true'}
                            >
                                {imageUrl && (
                                    <div class="announcement-panel__image-wrap">
                                        <img
                                            src={imageUrl}
                                            alt={item.title}
                                            loading={index === 0 ? 'eager' : 'lazy'}
                                            decoding={index === 0 ? 'sync' : 'async'}
                                            class="announcement-panel__image"
                                        />
                                    </div>
                                )}
                                <div class="announcement-panel__overlay">
                                    {typeLabel && (
                                        <span class="announcement-panel__type">{typeLabel}</span>
                                    )}
                                    {item.link_url && (
                                        <div class="announcement-panel__cta">
                                            <Button href={item.link_url} target="_blank" variant="primary">
                                                {linkLabel}
                                            </Button>
                                        </div>
                                    )}
                                </div>
                            </article>
                        );
                    })}
                </div>

                {orderedItems.length > 1 && (
                    <div class="announcement-spotlight__list" role="tablist" aria-label="Announcements list">
                        {orderedItems.map((item, index) => (
                            <button
                                type="button"
                                class:list={['announcement-list-item', { 'is-active': index === 0 }]}
                                data-announcement-tab={index}
                                role="tab"
                                aria-selected={index === 0 ? 'true' : 'false'}
                                aria-controls={`${sectionId}-panel-${index}`}
                                id={`${sectionId}-tab-${index}`}
                            >
                                <span class="announcement-list-item__title">{item.title}</span>
                                <span class="announcement-list-item__summary">{item.summary}</span>
                            </button>
                        ))}
                    </div>
                )}
            </div>
        </div>
    </section>
)}

<style>
    .announcement-spotlight__header {
        margin-bottom: 1.5rem;
    }

    .announcement-spotlight__title {
        margin-top: 0.75rem;
    }

    .announcement-spotlight__description {
        margin-top: 0.75rem;
        opacity: 0.85;
    }

    .announcement-spotlight__layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .announcement-spotlight__featured {
        min-width: 0;
    }

    .announcement-panel {
        display: none;
        position: relative;
        border: 1px solid rgba(var(--color-body-base-rgb), 0.12);
        border-radius: 0;
        overflow: hidden;
        background: var(--color-base);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .announcement-panel.is-active {
        display: block;
    }

    .announcement-panel__image-wrap {
        aspect-ratio: 16 / 9;
        background: rgba(var(--color-body-base-rgb), 0.06);
    }

    .announcement-panel__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .announcement-panel__overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.75rem;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0));
    }

    .announcement-panel__type {
        display: inline-flex;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: rgba(247, 147, 26, 0.16);
        color: var(--color-primary);
        padding: 0.2rem 0.55rem;
        border-radius: 9999px;
        margin: 0;
        align-self: flex-end;
    }

    .announcement-panel__cta {
        margin-left: auto;
        align-self: flex-end;
    }

    .announcement-spotlight__list {
        display: flex;
        flex-direction: column;
        gap: 0;
        border: 1px solid var(--color-primary);
        border-radius: 0;
        overflow: hidden;
        background: var(--color-background);
    }

    .announcement-list-item {
        width: 100%;
        text-align: left;
        background: var(--color-background);
        border: none;
        border-bottom: 1px solid color-mix(in srgb, var(--color-body-base) 15%, transparent);
        border-right: 4px solid transparent;
        border-radius: 0;
        padding: 0.85rem 1rem;
        transition: background-color 0.2s ease, border-color 0.2s ease;
        cursor: pointer;
    }

    .announcement-list-item:last-child {
        border-bottom: none;
    }

    .announcement-list-item:hover {
        background: var(--color-background-light);
        border-right-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
    }

    .announcement-list-item.is-active {
        background: color-mix(in srgb, var(--color-primary) 10%, var(--color-background));
        border-right-color: var(--color-primary);
    }

    .announcement-list-item__title {
        display: block;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-body-base);
        line-height: 1.3;
    }

    .announcement-list-item.is-active .announcement-list-item__title {
        color: var(--color-primary);
    }

    .announcement-list-item__summary {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.85rem;
        color: color-mix(in srgb, var(--color-body-base) 65%, transparent);
        line-height: 1.45;
    }

    .announcement-list-item.is-active .announcement-list-item__summary {
        color: var(--color-body-base);
    }

    @media (min-width: 1024px) {
        .announcement-spotlight__layout {
            grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
            gap: 0;
            align-items: start;
        }

        .announcement-spotlight__featured {
            border: 1px solid color-mix(in srgb, var(--color-body-base) 12%, transparent);
            border-right: none;
            border-radius: 0;
            overflow: hidden;
            background: var(--color-base);
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
        }

        .announcement-panel {
            border: none;
            border-radius: 0;
            box-shadow: none;
        }

        .announcement-spotlight__list {
            min-height: 100%;
            border-radius: 0;
        }

        .announcement-list-item {
            padding: 1rem 1.1rem;
        }
    }

    @media (max-width: 1023px) {
        .announcement-spotlight__list {
            display: none;
        }

        .announcement-panel {
            display: none;
        }

        .announcement-panel.is-active {
            display: block;
        }
    }
</style>

<script>
    function initAnnouncementSpotlights() {
        const roots = document.querySelectorAll<HTMLElement>('[data-announcement-spotlight]');

        roots.forEach((root) => {
            const tabs = root.querySelectorAll<HTMLButtonElement>('[data-announcement-tab]');
            const panels = root.querySelectorAll<HTMLElement>('[data-announcement-panel]');
            if (!tabs.length || panels.length <= 1) return;

            function activate(index: number) {
                tabs.forEach((tab, i) => {
                    const isActive = i === index;
                    tab.classList.toggle('is-active', isActive);
                    tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
                });

                panels.forEach((panel, i) => {
                    const isActive = i === index;
                    panel.classList.toggle('is-active', isActive);
                    panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
                });
            }

            tabs.forEach((tab) => {
                tab.addEventListener('click', () => {
                    const idx = Number(tab.dataset.announcementTab ?? 0);
                    activate(idx);
                });

                tab.addEventListener('keydown', (event) => {
                    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
                    event.preventDefault();
                    const currentIdx = Number(tab.dataset.announcementTab ?? 0);
                    const direction = event.key === 'ArrowDown' ? 1 : -1;
                    const nextIdx = (currentIdx + direction + tabs.length) % tabs.length;
                    tabs[nextIdx]?.focus();
                    activate(nextIdx);
                });
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initAnnouncementSpotlights);
    document.addEventListener('astro:page-load', initAnnouncementSpotlights);
</script>
