---
import Button from '@components/ui/Button.astro';
import { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-astro';
import {
    getPress,
    getPressSlug,
    getPressImageUrl,
    getMerchants,
    getMerchantImageUrl,
    type PressItem,
    type Merchant,
} from '@lib/directus';

export interface Props {
    content?: {
        title?: string;
        description?: string;
        button?: {
            text: string;
            link: string;
            variant?: 'primary' | 'secondary' | 'ghostLight' | 'ghostDark';
            size?: 'sm' | 'md' | 'lg' | 'xl' | 'xxl';
        };
    };
    fallbackImage?: ImageMetadata;
    limit?: number;
    autoAdvanceMs?: number;
    filterByType?: 'press_release' | 'in_the_news' | 'events';
}

type ImageMetadata = { src: string; width: number; height: number; format: string };

const {
    content,
    fallbackImage,
    limit = 6,
    autoAdvanceMs = 6000,
    filterByType,
} = Astro.props;

const pressResult = await getPress();
const merchantResult = await getMerchants();

const allPressItems: PressItem[] = pressResult.data ?? [];
const allMerchants: Merchant[] = merchantResult.data ?? [];

function getTimestamp(value: string | null | undefined): number {
    if (!value) return Number.NEGATIVE_INFINITY;
    const parsed = Date.parse(value);
    return Number.isFinite(parsed) ? parsed : Number.NEGATIVE_INFINITY;
}

const pressItems = allPressItems
    .filter(item => item.Cover)
    .filter(item => !filterByType || item.type === filterByType)
    .map(item => ({
        kind: 'event' as const,
        badgeLabel: 'Recent Event',
        imageUrl: getPressImageUrl(item.Cover, 1600) ?? '',
        title: item.Title,
        href: `/news/${getPressSlug(item)}`,
        excerpt: item.Subtitle ?? '',
        timestamp: getTimestamp(item.Date),
    }))
    .filter(item => item.imageUrl)
    .sort((a, b) => b.timestamp - a.timestamp);

const merchantItems = allMerchants
    .filter(item => item.Image_Primary)
    .map(item => {
        const onboardTimestamp = getTimestamp(item.Onboard_Date);
        return {
            kind: 'merchant' as const,
            badgeLabel: 'Merchant Spotlight',
            imageUrl: getMerchantImageUrl(item.Image_Primary, 1600) ?? '',
            title: item.Name,
            href: undefined,
            excerpt: item.Short_Description ?? '',
            timestamp: onboardTimestamp > Number.NEGATIVE_INFINITY
                ? onboardTimestamp
                : (item.Onboard_Block ?? Number.NEGATIVE_INFINITY),
        };
    })
    .filter(item => item.imageUrl)
    .sort((a, b) => b.timestamp - a.timestamp)
    .slice(0, 3);

type SlideKind = 'event' | 'merchant';

interface Slide {
    kind: SlideKind;
    badgeLabel: string;
    imageUrl: string;
    title: string;
    href?: string;
    excerpt: string;
    timestamp: number;
}

function interleaveSlides(events: Slide[], merchants: Slide[], maxItems: number): Slide[] {
    const mixed: Slide[] = [];
    let eventIndex = 0;
    let merchantIndex = 0;
    let turn: SlideKind = 'event';

    while (mixed.length < maxItems && (eventIndex < events.length || merchantIndex < merchants.length)) {
        if (turn === 'event') {
            if (eventIndex < events.length) {
                mixed.push(events[eventIndex++]);
            } else if (merchantIndex < merchants.length) {
                mixed.push(merchants[merchantIndex++]);
            }
            turn = 'merchant';
            continue;
        }

        if (merchantIndex < merchants.length) {
            mixed.push(merchants[merchantIndex++]);
        } else if (eventIndex < events.length) {
            mixed.push(events[eventIndex++]);
        }
        turn = 'event';
    }

    return mixed;
}

const slides: Slide[] = interleaveSlides(pressItems, merchantItems, limit);
const hasPressItems = slides.length > 0;

const carouselId = `press-hero-${Math.random().toString(36).slice(2, 11)}`;
---

<section
    class="press-hero"
    id={carouselId}
    data-press-hero
    data-auto-advance={autoAdvanceMs}
    aria-label="Community highlights"
    style="position:relative;width:100%;overflow:hidden;"
>
    {/* ===== DESKTOP: full-viewport immersive layout (hidden on mobile) ===== */}
    {hasPressItems && (
        <div class="press-hero__desktop">
            <div class="press-hero__slides">
                {slides.map((slide, i) => (
                    <div
                        class:list={['press-hero__slide', { 'is-active': i === 0 }]}
                        data-slide-index={i}
                        data-layout="desktop"
                        aria-hidden={i !== 0 ? 'true' : 'false'}
                    >
                        <img
                            src={slide.imageUrl}
                            alt=""
                            class="press-hero__image"
                            loading={i === 0 ? 'eager' : 'lazy'}
                            decoding={i === 0 ? 'sync' : 'async'}
                        />
                        <div class="press-hero__overlay" />
                    </div>
                ))}
            </div>

            <div class="press-hero__caption">
                {slides.map((slide, i) => (
                    slide.href ? (
                        <a
                            href={slide.href}
                            class:list={['press-hero__caption-item', { 'is-active': i === 0 }]}
                            data-caption-index={i}
                            data-layout="desktop"
                        >
                            <span class="press-hero__badge">{slide.badgeLabel}</span>
                            <h2 class="press-hero__slide-title">{slide.title}</h2>
                            {slide.excerpt && (
                                <p class="press-hero__slide-excerpt">{slide.excerpt}</p>
                            )}
                        </a>
                    ) : (
                        <div
                            class:list={['press-hero__caption-item', 'is-static', { 'is-active': i === 0 }]}
                            data-caption-index={i}
                            data-layout="desktop"
                        >
                            <span class="press-hero__badge">{slide.badgeLabel}</span>
                            <h2 class="press-hero__slide-title">{slide.title}</h2>
                            {slide.excerpt && (
                                <p class="press-hero__slide-excerpt">{slide.excerpt}</p>
                            )}
                        </div>
                    )
                ))}
            </div>

            {slides.length > 1 && (
                <Fragment>
                    <button class="press-hero__arrow press-hero__arrow--prev" data-hero-prev aria-label="Previous slide">
                        <ChevronLeft size={28} />
                    </button>
                    <button class="press-hero__arrow press-hero__arrow--next" data-hero-next aria-label="Next slide">
                        <ChevronRight size={28} />
                    </button>
                </Fragment>
            )}
        </div>
    )}

    {/* ===== MOBILE: card layout with full image + info below (hidden on desktop) ===== */}
    {hasPressItems && (
        <div class="press-hero__mobile">
            {slides.map((slide, i) => (
                <div
                    class:list={['press-hero__mobile-slide', { 'is-active': i === 0 }]}
                    data-mobile-slide-index={i}
                    aria-hidden={i !== 0 ? 'true' : 'false'}
                >
                    {slide.href ? (
                        <a href={slide.href} class="press-hero__mobile-image-wrap">
                            <img
                                src={slide.imageUrl}
                                alt=""
                                class="press-hero__mobile-image"
                                loading={i === 0 ? 'eager' : 'lazy'}
                                decoding={i === 0 ? 'sync' : 'async'}
                            />
                        </a>
                    ) : (
                        <div class="press-hero__mobile-image-wrap">
                            <img
                                src={slide.imageUrl}
                                alt=""
                                class="press-hero__mobile-image"
                                loading={i === 0 ? 'eager' : 'lazy'}
                                decoding={i === 0 ? 'sync' : 'async'}
                            />
                        </div>
                    )}
                    <div class="press-hero__mobile-info">
                        <span class="press-hero__badge">{slide.badgeLabel}</span>
                        {slide.href ? (
                            <a href={slide.href} class="press-hero__mobile-info-link">
                                <h2 class="press-hero__mobile-title">{slide.title}</h2>
                            </a>
                        ) : (
                            <div class="press-hero__mobile-info-link is-static">
                                <h2 class="press-hero__mobile-title">{slide.title}</h2>
                            </div>
                        )}
                        {slide.excerpt && (
                            <div class="press-hero__mobile-excerpt-wrap">
                                <p class="press-hero__mobile-excerpt" data-mobile-excerpt>{slide.excerpt}</p>
                                <button
                                    class="press-hero__show-more"
                                    data-show-more
                                    aria-label="Show more"
                                    aria-expanded="false"
                                    hidden
                                >
                                    <span>Show More</span>
                                    <ChevronDown size={14} />
                                </button>
                            </div>
                        )}
                    </div>
                </div>
            ))}
        </div>
    )}

    {/* ===== FALLBACK: static hero when CMS unavailable ===== */}
    {!hasPressItems && (
        <div class="press-hero__fallback" style="position:absolute;inset:0;">
            <div class="press-hero__slide is-active" style="position:absolute;inset:0;opacity:1;">
                {fallbackImage ? (
                    <img
                        src={fallbackImage.src}
                        alt=""
                        class="press-hero__image"
                        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
                        loading="eager"
                    />
                ) : (
                    <div class="press-hero__image press-hero__image--placeholder" style="position:absolute;inset:0;width:100%;height:100%;" />
                )}
                <div class="press-hero__overlay" style="position:absolute;inset:0;z-index:1;" />
            </div>
        </div>
    )}

    {!hasPressItems && (
        <div class="press-hero__content" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-60%);z-index:10;text-align:center;width:90%;max-width:48rem;">
            {content?.title && (
                <h1 class="press-hero__title" style="color:white;">{content.title}</h1>
            )}
            {content?.description && (
                <p class="press-hero__description" style="color:rgba(255,255,255,0.9);">{content.description}</p>
            )}
            {content?.button && (
                <div class="press-hero__cta">
                    <Button
                        href={content.button.link}
                        variant={content.button.variant || 'primary'}
                        size={content.button.size || 'xl'}
                    >
                        {content.button.text}
                    </Button>
                </div>
            )}
        </div>
    )}

    {/* ===== DOT INDICATORS + PROGRESS (shared) ===== */}
    {hasPressItems && slides.length > 1 && (
        <nav class="press-hero__dots" aria-label="Slide navigation">
            {slides.map((_, i) => (
                <button
                    class:list={['press-hero__dot', { 'is-active': i === 0 }]}
                    data-dot-index={i}
                    aria-label={`Go to slide ${i + 1}`}
                    aria-current={i === 0 ? 'true' : 'false'}
                />
            ))}
        </nav>
    )}

    {hasPressItems && slides.length > 1 && (
        <div class="press-hero__progress">
            <div class="press-hero__progress-bar" data-progress-bar />
        </div>
    )}
</section>

<style>
    /* =============================================
       BASE / SECTION
       ============================================= */
    .press-hero {
        position: relative;
        width: 100%;
        background: #0a0a0a;
    }

    /* =============================================
       DESKTOP LAYOUT  (>=768 px)
       Immersive full-viewport with overlay text
       ============================================= */
    .press-hero__desktop {
        display: none;
    }

    @media (min-width: 768px) {
        .press-hero {
            height: 100vh;
            height: 100dvh;
        }

        .press-hero__desktop {
            display: block;
            position: absolute;
            inset: 0;
        }

        .press-hero__mobile {
            display: none !important;
        }
    }

    .press-hero__slides {
        position: absolute;
        inset: 0;
    }

    .press-hero__slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.8s ease-in-out;
        will-change: opacity;
    }

    .press-hero__slide.is-active {
        opacity: 1;
        z-index: 1;
    }

    .press-hero__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .press-hero__image--placeholder {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    }

    .press-hero__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.75) 0%,
            rgba(0, 0, 0, 0.35) 40%,
            rgba(0, 0, 0, 0.15) 70%,
            rgba(0, 0, 0, 0.25) 100%
        );
        z-index: 1;
    }

    /* Desktop caption uses a wider content band on larger screens. */
    .press-hero__caption {
        position: absolute;
        left: clamp(1.5rem, 4vw, 4.5rem);
        right: clamp(1.5rem, 8vw, 7rem);
        bottom: clamp(4.75rem, 9vh, 7rem);
        z-index: 10;
        pointer-events: none;
    }

    .press-hero__caption-item {
        display: none;
        flex-direction: column;
        gap: 0.85rem;
        text-decoration: none;
        color: white;
        transition: opacity 0.3s ease;
        width: min(100%, 60vw);
        pointer-events: auto;
    }

    .press-hero__caption-item:hover {
        opacity: 0.85;
    }

    .press-hero__caption-item.is-static:hover {
        opacity: 1;
    }

    .press-hero__caption-item.is-active {
        display: flex;
    }

    .press-hero__badge {
        display: inline-flex;
        align-self: flex-start;
        padding: 0.22rem 0.6rem;
        border-radius: 9999px;
        background: rgba(247, 147, 26, 0.9);
        color: #111;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .press-hero__slide-title {
        font-size: clamp(2rem, 4.6vw, 4.35rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.03em;
        color: white;
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.45);
    }

    .press-hero__slide-excerpt {
        max-width: min(100%, 60vw);
        font-size: clamp(1rem, 1.35vw, 1.3rem);
        color: rgba(255, 255, 255, 0.88);
        line-height: 1.55;
        text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    }

    @media (min-width: 768px) and (max-width: 1023px) {
        .press-hero__caption {
            right: 2.5rem;
            bottom: 5.5rem;
        }

        .press-hero__caption-item {
            width: min(100%, 60vw);
        }

        .press-hero__slide-title {
            font-size: clamp(1.75rem, 4vw, 3rem);
        }

        .press-hero__slide-excerpt {
            max-width: min(100%, 60vw);
            font-size: 1rem;
        }
    }

    /* Desktop arrows */
    .press-hero__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 15;
        display: none;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: white;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.3s ease;
        opacity: 0;
    }

    .press-hero:hover .press-hero__arrow {
        opacity: 1;
    }

    .press-hero__arrow:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: translateY(-50%) scale(1.1);
    }

    .press-hero__arrow--prev { left: 1.5rem; }
    .press-hero__arrow--next { right: 1.5rem; }

    @media (min-width: 768px) {
        .press-hero__arrow {
            display: flex;
        }
    }

    /* =============================================
       MOBILE LAYOUT  (<768 px)
       Image + info flush below, fit to viewport
       ============================================= */
    .press-hero__mobile {
        position: relative;
        margin-top: var(--header-stack-height, 80px);
        height: calc(100vh - var(--header-stack-height, 80px));
        height: calc(100dvh - var(--header-stack-height, 80px));
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .press-hero__mobile-slide {
        display: none;
        flex-direction: column;
        color: white;
        opacity: 0;
        transition: opacity 0.5s ease-in-out;
        flex: 1;
        height: 100%;
        min-height: 0;
    }

    .press-hero__mobile-slide.is-active {
        display: flex;
        opacity: 1;
    }

    .press-hero__mobile-image-wrap {
        position: relative;
        width: 100%;
        flex: 0 0 50%;
        height: 50%;
        min-height: 0;
        overflow: hidden;
        background: #111;
        display: block;
        text-decoration: none;
    }

    .press-hero__mobile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .press-hero__mobile-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 0 0 50%;
        min-height: 0;
        overflow: hidden;
        padding: 1rem 1.25rem 2.25rem;
        background: linear-gradient(to bottom, #111 0%, #0a0a0a 100%);
    }

    .press-hero__mobile-info-link {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        text-decoration: none;
        color: white;
    }

    .press-hero__mobile-info-link.is-static {
        cursor: default;
    }

    .press-hero__mobile-title {
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.3;
        color: white;
    }

    .press-hero__mobile-excerpt-wrap {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .press-hero__mobile-excerpt {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.65);
        line-height: 1.55;
        overflow: hidden;
        min-height: 0;
        transition: max-height 0.3s ease;
    }

    .press-hero__mobile-excerpt.is-clamped {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
    }

    .press-hero__mobile-excerpt.is-expanded {
        display: block;
        -webkit-line-clamp: unset;
        max-height: none;
        overflow-y: auto;
        padding-right: 0.25rem;
    }

    .press-hero__show-more {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.375rem;
        padding: 0;
        border: none;
        background: none;
        color: var(--color-primary, #f7931a);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        cursor: pointer;
    }

    .press-hero__show-more.is-expanded .lucide-chevron-down {
        transform: rotate(180deg);
    }

    @media (min-width: 768px) {
        .press-hero__mobile {
            display: none !important;
        }
    }

    /* =============================================
       SHARED: Dots, Progress
       ============================================= */
    .press-hero__dots {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 15;
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .press-hero__dot {
        width: 0.5rem;
        height: 0.5rem;
        border: none;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.4);
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        padding: 0;
    }

    .press-hero__dot:hover {
        background: rgba(255, 255, 255, 0.7);
    }

    .press-hero__dot.is-active {
        width: 2rem;
        background: var(--color-primary, #f7931a);
    }

    .press-hero__progress {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: rgba(255, 255, 255, 0.1);
        z-index: 15;
    }

    .press-hero__progress-bar {
        height: 100%;
        width: 0%;
        background: var(--color-primary, #f7931a);
        transition: width 0.1s linear;
    }

    .press-hero__progress-bar.is-animating {
        transition: width linear;
    }

    @media (max-width: 767px) {
        .press-hero__dots {
            gap: 0.4rem;
        }

        .press-hero__dot {
            width: 0.6rem;
            height: 0.6rem;
        }

        .press-hero__dot.is-active {
            width: 2rem;
        }
    }

    /* =============================================
       FALLBACK (no CMS data)
       ============================================= */
    .press-hero__fallback {
        position: absolute;
        inset: 0;
    }

    .press-hero__content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -60%);
        z-index: 10;
        text-align: center;
        width: 90%;
        max-width: 48rem;
        pointer-events: none;
    }

    .press-hero__title {
        font-size: clamp(2rem, 5vw, 3.75rem);
        font-weight: 800;
        color: white;
        line-height: 1.1;
        margin-bottom: 1rem;
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
        letter-spacing: -0.02em;
    }

    .press-hero__description {
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: rgba(255, 255, 255, 0.9);
        line-height: 1.6;
        margin-bottom: 2rem;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
    }

    .press-hero__cta {
        pointer-events: auto;
    }

    /* Fallback needs full viewport height */
    .press-hero:has(.press-hero__fallback) {
        height: 100vh;
        height: 100dvh;
    }
</style>

<script>
    function initPressHero(container: HTMLElement) {
        const desktopSlides = container.querySelectorAll<HTMLElement>('[data-slide-index]');
        const desktopCaptions = container.querySelectorAll<HTMLElement>('[data-caption-index]');
        const mobileSlides = container.querySelectorAll<HTMLElement>('[data-mobile-slide-index]');
        const dots = container.querySelectorAll<HTMLButtonElement>('[data-dot-index]');
        const progressBar = container.querySelector<HTMLElement>('[data-progress-bar]');
        const prevBtn = container.querySelector<HTMLButtonElement>('[data-hero-prev]');
        const nextBtn = container.querySelector<HTMLButtonElement>('[data-hero-next]');

        const totalSlides = Math.max(desktopSlides.length, mobileSlides.length);
        if (totalSlides <= 1) return;

        const autoAdvanceMs = parseInt(container.dataset.autoAdvance ?? '6000', 10);
        let current = 0;
        let timer: ReturnType<typeof setInterval> | null = null;
        let isPaused = false;

        function goTo(index: number) {
            if (index === current) return;

            desktopSlides[current]?.classList.remove('is-active');
            desktopSlides[current]?.setAttribute('aria-hidden', 'true');
            desktopCaptions[current]?.classList.remove('is-active');
            mobileSlides[current]?.classList.remove('is-active');
            mobileSlides[current]?.setAttribute('aria-hidden', 'true');
            dots[current]?.classList.remove('is-active');
            dots[current]?.setAttribute('aria-current', 'false');

            current = ((index % totalSlides) + totalSlides) % totalSlides;

            desktopSlides[current]?.classList.add('is-active');
            desktopSlides[current]?.setAttribute('aria-hidden', 'false');
            desktopCaptions[current]?.classList.add('is-active');
            mobileSlides[current]?.classList.add('is-active');
            mobileSlides[current]?.setAttribute('aria-hidden', 'false');
            dots[current]?.classList.add('is-active');
            dots[current]?.setAttribute('aria-current', 'true');

            resetProgress();
        }

        function next() {
            goTo(current + 1);
        }

        function prev() {
            goTo(current - 1);
        }

        function resetProgress() {
            if (!progressBar) return;
            progressBar.classList.remove('is-animating');
            progressBar.style.width = '0%';

            void progressBar.offsetWidth;
            progressBar.classList.add('is-animating');
            progressBar.style.transitionDuration = `${autoAdvanceMs}ms`;
            progressBar.style.width = '100%';
        }

        function startAutoAdvance() {
            stopAutoAdvance();
            resetProgress();
            timer = setInterval(() => {
                if (!isPaused) {
                    next();
                }
            }, autoAdvanceMs);
        }

        function stopAutoAdvance() {
            if (timer) {
                clearInterval(timer);
                timer = null;
            }
        }

        dots.forEach((dot) => {
            dot.addEventListener('click', () => {
                const idx = parseInt(dot.dataset.dotIndex ?? '0', 10);
                goTo(idx);
                startAutoAdvance();
            });
        });

        prevBtn?.addEventListener('click', () => {
            prev();
            startAutoAdvance();
        });

        nextBtn?.addEventListener('click', () => {
            next();
            startAutoAdvance();
        });

        container.addEventListener('mouseenter', () => {
            isPaused = true;
            if (progressBar) {
                progressBar.classList.remove('is-animating');
            }
        });

        container.addEventListener('mouseleave', () => {
            isPaused = false;
            if (progressBar) {
                resetProgress();
            }
        });

        let touchStartX = 0;
        const SWIPE_THRESHOLD = 50;

        container.addEventListener('touchstart', (e: TouchEvent) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        container.addEventListener('touchend', (e: TouchEvent) => {
            const touchEndX = e.changedTouches[0].screenX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > SWIPE_THRESHOLD) {
                if (diff > 0) {
                    next();
                } else {
                    prev();
                }
                startAutoAdvance();
            }
        }, { passive: true });

        container.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'ArrowLeft') {
                prev();
                startAutoAdvance();
            } else if (e.key === 'ArrowRight') {
                next();
                startAutoAdvance();
            }
        });

        const mobileMediaQuery = window.matchMedia('(max-width: 767px)');

        // Mobile excerpt show-more toggle
        container.querySelectorAll<HTMLElement>('[data-mobile-excerpt]').forEach((excerpt) => {
            const btn = excerpt.parentElement?.querySelector<HTMLButtonElement>('[data-show-more]');
            if (!btn) return;
            const button = btn;
            const buttonLabel = button.querySelector('span');
            const mobileInfo = excerpt.closest<HTMLElement>('.press-hero__mobile-info');
            let frameId: number | null = null;
            let resizeObserver: ResizeObserver | null = null;

            function setCollapsedState() {
                excerpt.classList.remove('is-expanded');
                excerpt.classList.add('is-clamped');
                button.classList.remove('is-expanded');
                button.setAttribute('aria-expanded', 'false');
                if (buttonLabel) buttonLabel.textContent = 'Show More';
            }

            function setExpandedState() {
                excerpt.classList.remove('is-clamped');
                excerpt.classList.add('is-expanded');
                button.classList.add('is-expanded');
                button.setAttribute('aria-expanded', 'true');
                if (buttonLabel) buttonLabel.textContent = 'Show Less';
            }

            function checkClamp() {
                frameId = null;

                if (!excerpt.isConnected) return;

                const isVisible = excerpt.getClientRects().length > 0;
                const isMobileLayout = mobileMediaQuery.matches && isVisible;

                if (!isMobileLayout) {
                    setCollapsedState();
                    button.hidden = true;
                    return;
                }

                const wasExpanded = excerpt.classList.contains('is-expanded');
                setCollapsedState();

                const expandedWouldFit = (() => {
                    if (!mobileInfo) return false;

                    setExpandedState();
                    button.hidden = true;

                    return mobileInfo.scrollHeight <= mobileInfo.clientHeight + 2;
                })();

                if (expandedWouldFit) {
                    button.hidden = true;
                    return;
                }

                setCollapsedState();

                const shouldShowToggle = excerpt.scrollHeight > excerpt.clientHeight + 2;
                button.hidden = !shouldShowToggle;

                if (shouldShowToggle && wasExpanded) {
                    setExpandedState();
                }
            }

            function scheduleClampCheck() {
                if (frameId !== null) cancelAnimationFrame(frameId);
                frameId = window.requestAnimationFrame(checkClamp);
            }

            button.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const expanded = excerpt.classList.contains('is-expanded');
                if (expanded) {
                    setCollapsedState();
                } else {
                    setExpandedState();
                }
            });

            scheduleClampCheck();
            window.addEventListener('resize', scheduleClampCheck);

            if (typeof mobileMediaQuery.addEventListener === 'function') {
                mobileMediaQuery.addEventListener('change', scheduleClampCheck);
            } else if (typeof mobileMediaQuery.addListener === 'function') {
                mobileMediaQuery.addListener(scheduleClampCheck);
            }

            if (typeof ResizeObserver !== 'undefined') {
                resizeObserver = new ResizeObserver(scheduleClampCheck);
                resizeObserver.observe(excerpt);
                excerpt.parentElement && resizeObserver.observe(excerpt.parentElement);
            }

            if (document.fonts?.ready) {
                document.fonts.ready.then(scheduleClampCheck).catch(() => {});
            }
        });

        startAutoAdvance();
    }

    function initAllPressHeroes() {
        document.querySelectorAll<HTMLElement>('[data-press-hero]').forEach(initPressHero);
    }

    document.addEventListener('DOMContentLoaded', initAllPressHeroes);
    document.addEventListener('astro:page-load', initAllPressHeroes);
</script>
